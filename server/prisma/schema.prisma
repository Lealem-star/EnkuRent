generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  TENANT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OfficeStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum ContractFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ContractStatus {
  ACTIVE
  ENDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHAPA
  TELEBIRR
  CBE_BIRR
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum GatewayProvider {
  CHAPA
  TELEBIRR
  CBE_BIRR
  BANK_TRANSFER
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  phone             String?
  passwordHash      String
  role              Role            @default(TENANT)
  title             String?         // e.g. "Accountant", "Manager", "Owner"
  companyName       String?
  notes             String?         @db.Text
  approvalStatus    ApprovalStatus  @default(APPROVED)
  isActive          Boolean         @default(true)
  ownerId           String?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  owner             User?           @relation("OwnerTeam", fields: [ownerId], references: [id], onDelete: SetNull)
  teamMembers       User[]          @relation("OwnerTeam")
  ownedBuildings    Building[]      @relation("OwnerBuildings")

  buildings         UserBuilding[]
  tenantProfile     Tenant?
  verifiedPayments  Payment[]       @relation("VerifiedPayments")

  subscriptions        Subscription[]
  subscriptionInvoices SubscriptionInvoice[]
  tickets              SupportTicket[]       @relation("UserTickets")
  assignedTickets      SupportTicket[]       @relation("AssignedTickets")

  @@index([role])
  @@index([ownerId])
  @@index([approvalStatus])
  @@map("users")
}

model UserBuilding {
  id         String   @id @default(cuid())
  userId     String
  buildingId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([userId, buildingId])
  @@index([userId])
  @@index([buildingId])
  @@map("user_buildings")
}

model Building {
  id        String         @id @default(cuid())
  name      String
  address   String
  floors    Int
  ownerId   String?
  isDeleted Boolean        @default(false)
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner     User?          @relation("OwnerBuildings", fields: [ownerId], references: [id], onDelete: SetNull)
  offices   Office[]
  payments  Payment[]
  managers  UserBuilding[]

  @@index([ownerId])
  @@index([createdAt])
  @@map("buildings")
}

model Office {
  id           String         @id @default(cuid())
  buildingId   String
  floor        Int
  number       Int
  status       OfficeStatus   @default(AVAILABLE)
  isDeleted    Boolean        @default(false)
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  building     Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  contracts    Contract[]
  payments     Payment[]
  auditEntries AuditLog[]

  @@unique([buildingId, number])
  @@index([buildingId])
  @@index([status])
  @@index([floor])
  @@map("offices")
}

model Tenant {
  id          String     @id @default(cuid())
  userId      String?    @unique
  fullName    String
  phone       String
  email       String
  idNumber    String?
  isDeleted   Boolean    @default(false)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts   Contract[]
  payments    Payment[]
  documents   Document[]

  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@map("tenants")
}

model Contract {
  id            String            @id @default(cuid())
  officeId      String
  tenantId      String
  rent          Decimal           @db.Decimal(12, 2)
  frequency     ContractFrequency @default(MONTHLY)
  startDate     DateTime
  endDate       DateTime
  dueDay        Int               @default(5)
  status        ContractStatus    @default(ACTIVE)
  endedAt       DateTime?
  isDeleted     Boolean           @default(false)
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  office        Office            @relation(fields: [officeId], references: [id], onDelete: Restrict)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rentHistories RentHistory[]
  payments      Payment[]
  documents     Document[]

  @@index([officeId])
  @@index([tenantId])
  @@index([status])
  @@index([endDate])
  @@index([startDate])
  @@map("contracts")
}

model RentHistory {
  id            String    @id @default(cuid())
  contractId    String
  rent          Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("rent_histories")
}

model Payment {
  id               String        @id @default(cuid())
  contractId       String
  officeId         String
  buildingId       String
  tenantId         String
  period           String        // e.g. "September 2026"
  expectedAmount   Decimal       @db.Decimal(12, 2)
  amount           Decimal       @db.Decimal(12, 2)
  dueDate          DateTime
  paymentDate      DateTime?
  submittedAt      DateTime      @default(now())
  method           PaymentMethod @default(BANK_TRANSFER)
  txnRef           String?
  status           PaymentStatus @default(PENDING)
  verifiedById     String?
  verifiedBySystem Boolean       @default(false)
  isManual         Boolean       @default(false)
  rejectionReason  String?
  note             String?       @db.Text
  receiptUrl       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contract         Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  office           Office        @relation(fields: [officeId], references: [id], onDelete: Cascade)
  building         Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verifiedBy       User?         @relation("VerifiedPayments", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([officeId])
  @@index([buildingId])
  @@index([tenantId])
  @@index([status])
  @@index([submittedAt])
  @@index([dueDate])
  @@index([paymentDate])
  @@map("payments")
}

model Document {
  id         String    @id @default(cuid())
  contractId String?
  tenantId   String?
  type       String    // e.g. "Lease Agreement", "Tenant ID", "Other"
  name       String
  fileUrl    String
  uploadedAt DateTime  @default(now())

  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([tenantId])
  @@map("documents")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorName  String
  actorId    String?
  action     String
  entityType String
  entityId   String
  officeId   String?
  meta       String?  @db.Text
  createdAt  DateTime @default(now())

  office     Office?  @relation(fields: [officeId], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([createdAt])
  @@index([actorId])
  @@index([entityType])
  @@index([action])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// ENQOPA SAAS PLATFORM ARCHITECTURE (SUPER ADMIN SUITE)
// -------------------------------------------------------------

model SubscriptionPlan {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?        @db.Text
  priceMonthly    Decimal        @db.Decimal(12, 2)
  priceYearly     Decimal        @db.Decimal(12, 2)
  currency        String         @default("ETB")
  maxProperties   Int            @default(2)
  maxOffices      Int            @default(25)
  maxStaff        Int            @default(3)
  features        String?        @db.Text // JSON string of features & entitlements
  trialDays       Int            @default(14)
  gracePeriodDays Int            @default(7)
  isActive        Boolean        @default(true)
  isEnterprise    Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscriptions   Subscription[]

  @@index([isActive])
  @@map("subscription_plans")
}

model Subscription {
  id              String             @id @default(cuid())
  ownerId         String
  planId          String
  billingCycle    SubscriptionCycle  @default(MONTHLY)
  status          SubscriptionStatus @default(TRIAL)
  amount          Decimal            @db.Decimal(12, 2)
  currency        String             @default("ETB")
  startDate       DateTime           @default(now())
  endDate         DateTime
  renewsAt        DateTime?
  trialEndsAt     DateTime?
  cancelledAt     DateTime?
  notes           String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan   @relation(fields: [planId], references: [id])
  invoices        SubscriptionInvoice[]

  @@index([ownerId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id             String            @id @default(cuid())
  subscriptionId String
  ownerId        String
  invoiceNumber  String            @unique
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("ETB")
  billingCycle   SubscriptionCycle
  period         String            // e.g. "November 2026"
  status         PaymentStatus     @default(PENDING)
  paymentMethod  PaymentMethod     @default(BANK_TRANSFER)
  txnRef         String?
  paidAt         DateTime?
  receiptUrl     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([ownerId])
  @@index([status])
  @@map("subscription_invoices")
}

model GatewayConfig {
  id             String          @id @default(cuid())
  provider       GatewayProvider @unique
  name           String
  isEnabled      Boolean         @default(false)
  isLive         Boolean         @default(false)
  publicKey      String?         @db.Text
  secretKey      String?         @db.Text
  merchantId     String?
  webhookSecret  String?         @db.Text
  feePercent     Decimal         @default(0) @db.Decimal(5, 2)
  instructions   String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("gateway_configs")
}

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  userId       String
  ownerId      String?
  subject      String
  description  String          @db.Text
  priority     TicketPriority  @default(MEDIUM)
  category     String          @default("GENERAL") // GENERAL, BILLING, TECHNICAL, ONBOARDING
  status       TicketStatus    @default(OPEN)
  assignedToId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]

  @@index([userId])
  @@index([ownerId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  senderId    String
  senderName  String
  senderRole  Role
  message     String        @db.Text
  isInternal  Boolean       @default(false)
  attachments String?       @db.Text
  createdAt   DateTime      @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

model PlatformNotification {
  id            String   @id @default(cuid())
  title         String
  message       String   @db.Text
  type          String   @default("INFO") // INFO, WARNING, MAINTENANCE, SUCCESS
  targetRole    String   @default("ALL")  // ALL, OWNER, MANAGER, TENANT
  targetOwnerId String?
  isGlobal      Boolean  @default(true)
  sentById      String?
  createdAt     DateTime @default(now())

  @@index([targetRole])
  @@index([createdAt])
  @@map("platform_notifications")
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  category    String   @default("GENERAL") // GENERAL, LOCALIZATION, FINANCIAL, SECURITY, PLATFORM
  description String?
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("platform_settings")
}
