generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  TENANT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OfficeStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum ContractFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ContractStatus {
  ACTIVE
  ENDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHAPA
  TELEBIRR
  CBE_BIRR
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  phone             String?
  passwordHash      String
  role              Role            @default(TENANT)
  title             String?         // e.g. "Accountant", "Manager", "Owner"
  companyName       String?
  notes             String?         @db.Text
  approvalStatus    ApprovalStatus  @default(APPROVED)
  isActive          Boolean         @default(true)
  ownerId           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  owner             User?           @relation("OwnerTeam", fields: [ownerId], references: [id], onDelete: SetNull)
  teamMembers       User[]          @relation("OwnerTeam")
  ownedBuildings    Building[]      @relation("OwnerBuildings")

  buildings         UserBuilding[]
  tenantProfile     Tenant?
  verifiedPayments  Payment[]       @relation("VerifiedPayments")

  @@map("users")
}

model UserBuilding {
  id         String   @id @default(cuid())
  userId     String
  buildingId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([userId, buildingId])
  @@index([userId])
  @@index([buildingId])
  @@map("user_buildings")
}

model Building {
  id        String         @id @default(cuid())
  name      String
  address   String
  floors    Int
  ownerId   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner     User?          @relation("OwnerBuildings", fields: [ownerId], references: [id], onDelete: SetNull)
  offices   Office[]
  payments  Payment[]
  managers  UserBuilding[]

  @@index([ownerId])
  @@map("buildings")
}

model Office {
  id           String         @id @default(cuid())
  buildingId   String
  floor        Int
  number       Int
  status       OfficeStatus   @default(AVAILABLE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  building     Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  contracts    Contract[]
  payments     Payment[]
  auditEntries AuditLog[]

  @@unique([buildingId, number])
  @@index([buildingId])
  @@map("offices")
}

model Tenant {
  id          String     @id @default(cuid())
  userId      String?    @unique
  fullName    String
  phone       String
  email       String
  idNumber    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts   Contract[]
  payments    Payment[]
  documents   Document[]

  @@map("tenants")
}

model Contract {
  id            String            @id @default(cuid())
  officeId      String
  tenantId      String
  rent          Decimal           @db.Decimal(12, 2)
  frequency     ContractFrequency @default(MONTHLY)
  startDate     DateTime
  endDate       DateTime
  dueDay        Int               @default(5)
  status        ContractStatus    @default(ACTIVE)
  endedAt       DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  office        Office            @relation(fields: [officeId], references: [id], onDelete: Restrict)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rentHistories RentHistory[]
  payments      Payment[]
  documents     Document[]

  @@index([officeId])
  @@index([tenantId])
  @@map("contracts")
}

model RentHistory {
  id            String    @id @default(cuid())
  contractId    String
  rent          Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("rent_histories")
}

model Payment {
  id               String        @id @default(cuid())
  contractId       String
  officeId         String
  buildingId       String
  tenantId         String
  period           String        // e.g. "September 2026"
  expectedAmount   Decimal       @db.Decimal(12, 2)
  amount           Decimal       @db.Decimal(12, 2)
  dueDate          DateTime
  paymentDate      DateTime?
  submittedAt      DateTime      @default(now())
  method           PaymentMethod @default(BANK_TRANSFER)
  txnRef           String?
  status           PaymentStatus @default(PENDING)
  verifiedById     String?
  verifiedBySystem Boolean       @default(false)
  isManual         Boolean       @default(false)
  rejectionReason  String?
  note             String?       @db.Text
  receiptUrl       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contract         Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  office           Office        @relation(fields: [officeId], references: [id], onDelete: Cascade)
  building         Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verifiedBy       User?         @relation("VerifiedPayments", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([officeId])
  @@index([buildingId])
  @@index([tenantId])
  @@index([status])
  @@map("payments")
}

model Document {
  id         String    @id @default(cuid())
  contractId String?
  tenantId   String?
  type       String    // e.g. "Lease Agreement", "Tenant ID", "Other"
  name       String
  fileUrl    String
  uploadedAt DateTime  @default(now())

  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([tenantId])
  @@map("documents")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorName  String
  actorId    String?
  action     String
  entityType String
  entityId   String
  officeId   String?
  meta       String?
  createdAt  DateTime @default(now())

  office     Office?  @relation(fields: [officeId], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([createdAt])
  @@map("audit_logs")
}
